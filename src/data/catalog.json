    "rules": [
        {
            "id": "r-pccb-wheel-clearance",
            "type": "requires",
            "when": [
                "p-pccb"
            ],
            "then": [
                "w-carrera-exclusive-20",
                "w-rs-spyder-20"
            ],
            "message": "Ceramic composite brakes require Carrera Exclusive or RS Spyder wheels for caliper clearance."
        },
        {
            "id": "r-buckets-no-heating",
            "type": "excludes",
            "when": [
                "i-lightweight-buckets"
            ],
            "then": [
                "p-heated-seats"
            ],
            "message": "Full bucket seats are not available with seat heating."
        },
        {
            "id": "r-roof-conflict",
            "type": "excludes",
            "when": [
                "p-sunroof"
            ],
            "then": [
                "p-carbon-roof"
            ],
            "message": "The carbon fibre roof cannot be combined with the sliding glass sunroof."
        },
        {
            "id": "r-rear-steer-needs-pasm",
            "type": "requires",
            "when": [
                "p-rear-axle-steer"
            ],
            "then": [
                "p-pasm-sport"
            ],
            "message": "Rear-axle steering is only available with PASM Sport Suspension."
        },
        {
            "id": "r-buckets-need-sport-suspension",
            "type": "requires",
            "when": [
                "i-lightweight-buckets"
            ],
            "then": [
                "p-pasm-sport"
            ],
            "message": "Full bucket seats are only offered alongside PASM Sport Suspension."
        }
    ],
